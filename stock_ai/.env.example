# J-Quants 認証（以下のどちらかを設定）

# 方法1: リフレッシュトークン（推奨）
# 取得方法: https://jpx-jquants.com/ にログイン → マイページ → リフレッシュトークン発行
# または旧設定の JQUANTS_API_KEY もそのまま利用可能
JQUANTS_REFRESH_TOKEN=your_refresh_token_here

# 方法2: メールアドレス + パスワード
# JQUANTS_EMAIL=your_email@example.com
# JQUANTS_PASSWORD=your_password

# LINE Messaging API（デイトレ判定のシグナル変化通知用、任意）
# 取得方法: https://developers.line.biz/ でチャネル作成 → チャネルアクセストークン発行
# LINE_USER_ID は通知を受け取る自分のLINE ID（チャネルを友だち追加した上で取得）
# LINE_CHANNEL_ACCESS_TOKEN=your_channel_access_token
# LINE_USER_ID=your_line_user_id
